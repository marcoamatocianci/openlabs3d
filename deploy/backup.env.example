# Copy to deploy/backup.env on the server (chmod 600; never commit it). Read by deploy/backup.sh.
# Off-server, encrypted backups with restic: any restic backend works, e.g. an S3-compatible bucket,
# Backblaze B2 or SFTP to another machine. Keep a copy of RESTIC_PASSWORD somewhere other than this server:
# without it the backups cannot be read.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# For S3-compatible storage:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BACKUP_DIR=/var/backups/openlabs3d
KEEP_LOCAL=7
