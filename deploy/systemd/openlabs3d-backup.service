[Unit]
Description=OpenLabs3D backup (PostgreSQL, uploads, configuration; off-server copy with restic)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/openlabs3d
ExecStart=/srv/openlabs3d/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
