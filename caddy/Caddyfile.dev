:80 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
    handle /api/* {
        request_body {
            max_size 30MB
        }
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle {
        root * /srv
        file_server
    }
}
