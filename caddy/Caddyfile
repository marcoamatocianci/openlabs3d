{
    # Admin API off: nothing on the server needs it, and it would otherwise listen inside the container.
    admin off
}

{$SITE_DOMAIN} {
    # Caddy's default types plus glTF models: GLB previews shrink about 4x with gzip, and need no decoder.
    encode {
        zstd
        gzip 5
        minimum_length 1024
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/javascript*
            header Content-Type application/xhtml+xml*
            header Content-Type application/xml*
            header Content-Type application/wasm*
            header Content-Type image/svg+xml*
            header Content-Type model/gltf-binary*
            header Content-Type model/gltf+json*
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        -Server
    }
    @frontend path / /index.html *.css *.js
    header @frontend Cache-Control "no-cache"
    @static_models path /assets/models/*.glb /assets/products/* /assets/hero/* /assets/brand/*
    header @static_models Cache-Control "public, max-age=86400"
    handle /api/* {
        request_body {
            max_size 30MB
        }
        reverse_proxy backend:8000 {
            # The backend is reachable only through this proxy, so this header is the client address it trusts.
            header_up X-Real-IP {remote_host}
            # Fail fast while the backend restarts during a deployment.
            lb_try_duration 10s
        }
    }
    handle {
        root * /srv
        file_server
    }
}
