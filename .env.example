APP_ENV=development
SITE_DOMAIN=localhost
DATABASE_URL=sqlite:////app/data/openlabs3d.db
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGES_PER_LISTING=5

# Development mail is written privately to UPLOAD_DIR/mail; never publicly served.
MAIL_TRANSPORT=file
PUBLIC_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=noreply@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
