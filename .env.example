APP_ENV=development
SITE_DOMAIN=localhost
DATABASE_URL=sqlite:////app/data/openlabs3d.db
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGES_PER_LISTING=5

# Email. See docs/email/EMAIL_VERIFICATION.md.
# Development needs nothing here: `docker compose up` loads compose.override.yaml, which sends everything to the
# local Mailpit (http://127.0.0.1:8025) and ignores the SMTP values below. Never commit real credentials.
# Production: the public https address of the site.
APP_PUBLIC_URL=http://localhost:8080
EMAIL_VERIFICATION_EXPIRY_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_RESEND_HOURLY_LIMIT=5
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OpenLabs3D
SMTP_REPLY_TO=
# STARTTLS on port 587 (the default), or SMTP_USE_SSL=true and SMTP_USE_STARTTLS=false on port 465.
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Production mail: Brevo (SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, login and SMTP key from Brevo's SMTP tab).

# Sign in with Google (optional; the button appears once both are set). See docs/authentication/AUTHENTICATION.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to APP_PUBLIC_URL/api/auth/google/callback. Must match Google's setting exactly.
GOOGLE_OAUTH_REDIRECT_URI=
